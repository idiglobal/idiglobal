generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(CLIENT)
  clientId     String?  @unique
  client       Client?  @relation(fields: [clientId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Client {
  id          String   @id @default(cuid())
  companyName String
  contactName String
  email       String   @unique
  phone       String?
  address     String?
  conditions  String?
  user        User?
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Supplier {
  id           String    @id @default(cuid())
  name         String
  contactEmail String?
  contactPhone String?
  products     String
  leadTimeDays Int       @default(14)
  priceTier    PriceTier @default(STANDARD)
  notes        String?
  orders       Order[]
  catalog      Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Product {
  id          String      @id @default(cuid())
  reference   String      @unique
  name        String
  description String?
  collection  String?
  category    String?
  unitPrice   Float
  supplierId  String?
  supplier    Supplier?   @relation(fields: [supplierId], references: [id])
  colors      String?
  sizes       String?
  minQuantity Int         @default(1)
  available   Boolean     @default(true)
  imageUrl    String?
  gallery     String?
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  status         OrderStatus @default(QUOTE_SENT)
  clientId       String
  client         Client      @relation(fields: [clientId], references: [id])
  supplierId     String?
  supplier       Supplier?   @relation(fields: [supplierId], references: [id])
  items          OrderItem[]
  notes          OrderNote[]
  expenses       OrderExpense[]
  totalAmount      Float       @default(0)
  referenceFiles   String?
  designPlacement  String?
  clientNotes      String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String?
  catalogItem   Product? @relation(fields: [productId], references: [id])
  product       String
  description   String?
  color         String?
  size          String?
  quantity      Int
  unitPrice     Float
  total         Float
}

model OrderNote {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  content    String
  isInternal Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model OrderExpense {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  concept   String
  amount    Float
  notes     String?
  createdAt DateTime @default(now())
}

// ─── Prospección B2B ─────────────────────────────────────────────────────────
// Tablas compartidas con el worker Python (idiglobal-worker) vía SQLAlchemy:
// los nombres snake_case de tabla/columna son un contrato — no renombrar.

model ProspectLead {
  id              Int       @id @default(autoincrement())
  name            String    @db.VarChar(255)
  category        String?   @db.VarChar(255)
  address         String?   @db.VarChar(500)
  city            String?   @db.VarChar(120)
  phone           String?   @db.VarChar(60)
  website         String?   @db.VarChar(500)
  rating          Float?
  reviewsCount    Int?      @map("reviews_count")
  searchKeyword   String?   @map("search_keyword") @db.VarChar(255)
  segment         String    @default("eventos") @db.VarChar(20)
  intentScore     Int       @default(0) @map("intent_score")
  intentSignals   String?   @map("intent_signals")
  email           String?   @db.VarChar(255)
  contactName     String?   @map("contact_name") @db.VarChar(255)
  enrichmentNotes String?   @map("enrichment_notes")
  emailStatus     String    @default("no_verificado") @map("email_status") @db.VarChar(20)
  emailCheckedAt  DateTime? @map("email_checked_at")
  emailSubject    String?   @map("email_subject") @db.VarChar(500)
  emailBody       String?   @map("email_body")
  status          String    @default("nuevo") @db.VarChar(40)
  lastSentAt      DateTime? @map("last_sent_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  // Campaña temporal a la que pertenece el lead (p. ej. "septiembre" para
  // colegios/AMPAs y equipos deportivos, en pausa mientras están cerrados).
  // null = pipeline activo normal. El worker la asigna al crear el lead
  // según la keyword de búsqueda; ver idiglobal-worker/campanas.py.
  campaign        String?   @db.VarChar(40)

  @@unique([name, address], map: "uq_prospect_lead_name_address")
  @@map("prospect_leads")
}

model ProspectJob {
  id         Int       @id @default(autoincrement())
  type       String    @db.VarChar(20) // scrape|scrape_intent|enrich|filter|verify|generate|send
  params     Json?
  status     String    @default("pending") @db.VarChar(10) // pending|running|done|error
  log        String?
  createdAt  DateTime  @default(now()) @map("created_at")
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")

  @@map("prospect_jobs")
}

model ProspectSendLog {
  id           Int      @id @default(autoincrement())
  leadId       Int      @map("lead_id")
  emailTo      String   @map("email_to") @db.VarChar(255)
  subject      String?  @db.VarChar(500)
  success      Boolean  @default(false)
  errorMessage String?  @map("error_message")
  sentAt       DateTime @default(now()) @map("sent_at")
  sendDate     DateTime @default(dbgenerated("CURRENT_DATE")) @map("send_date") @db.Date

  // Seguimiento real del envío. `success` solo dice que Resend aceptó la
  // petición; lo que pasa después llega por webhook y se cruza con este id.
  providerMessageId String?   @unique @map("provider_message_id") @db.VarChar(120)
  deliveryStatus    String?   @map("delivery_status") @db.VarChar(20)
  deliveryDetail    String?   @map("delivery_detail")
  deliveryUpdatedAt DateTime? @map("delivery_updated_at")

  @@map("prospect_send_logs")
}

model ProspectSuppression {
  id        Int      @id @default(autoincrement())
  email     String   @unique @db.VarChar(255)
  reason    String   @default("manual") @db.VarChar(20) // baja|rebote|queja|manual
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("prospect_suppressions")
}

enum Role {
  ADMIN
  CLIENT
}

enum OrderStatus {
  QUOTE_SENT
  BUDGET_SENT
  CONFIRMED
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PriceTier {
  ECONOMY
  STANDARD
  PREMIUM
}
